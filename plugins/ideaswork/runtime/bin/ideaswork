#!/bin/sh
# Thin Runtime Core launcher. The native program is not bundled: it is installed by the npm package
# pinned to this plugin's exact version (see skills/*/references/PLUGIN_RUNTIME.md).
set -eu
spec='@ideaswork/cli-preprod@2026.1118.131717-preprod'
package='@ideaswork/cli-preprod'
version='2026.1118.131717-preprod'
if ! command -v node >/dev/null 2>&1; then
  echo "IdeasWork: Node.js 22+ (node) is required for the local Runtime Core." >&2
  echo "  错误码：node_missing" >&2
  exit 2
fi
# Private, otherwise empty npm project root: npm must never read the caller's repository .npmrc (e.g. a
# hostile @ideaswork:registry=) or node_modules, which would defeat the exact-version pin. The Runtime Core
# itself still starts in the caller's working directory. mkdir/mktemp are not shell builtins and PATH may
# be minimal; node is already required, so fall back to it.
if [ -n "${HOME:-}" ]; then
  prefix="$HOME/.ideaswork/npx"
  [ -d "$prefix" ] || (umask 077; mkdir -p "$prefix") 2>/dev/null ||
    node -e 'require("fs").mkdirSync(process.argv[1], { recursive: true, mode: 0o700 })' "$prefix"
else
  prefix="$(mktemp -d 2>/dev/null ||
    node -p 'require("fs").mkdtempSync(require("path").join(require("os").tmpdir(), "ideaswork-npx-"))')"
fi
package_dir="$prefix/node_modules/$package"
entry="$package_dir/scripts/run.cjs"
# The prefix must hold exactly the version this plugin pins; anything else is reinstalled below.
pinned() {
  node -e 'process.exit(require(process.argv[1] + "/package.json").version === process.argv[2] ? 0 : 1)' \
    "$package_dir" "$version" >/dev/null 2>&1
}
if pinned && [ -f "$entry" ]; then
  exec node "$entry" --runtime-only "$@"
fi
if ! command -v npm >/dev/null 2>&1; then
  echo "IdeasWork: Node.js 22+ (npm) is required to install the local Runtime Core." >&2
  echo "  错误码：npm_missing" >&2
  exit 2
fi
# First run of this version, or an upgrade. `--prefer-online` revalidates the packument; when the registry
# is unreachable npm falls back to its cached response and says which failure this is below.
# cd into the private prefix so npm reads that prefix's project config, never the caller's repository.
if ! probe="$( cd "$prefix" && npm install --prefix "$prefix" --prefer-online --no-save --no-audit --no-fund "$spec" </dev/null 2>&1 )"; then
  case "$probe" in
    *ETARGET*|*"No matching version"*)
      echo "IdeasWork: npm registry 上查不到 ${spec}，或本地 npm 缓存缺少该版本且当前无法联网刷新。" >&2
      echo "  错误码：npm_version_not_found" >&2
      echo "  请确认该版本已发布并与插件版本一致；不要改用其他版本，也不要清空整个 npm 缓存。" >&2 ;;
    *ENOTFOUND*|*EAI_AGAIN*|*ECONNREFUSED*|*ECONNRESET*|*ETIMEDOUT*|*ENETUNREACH*|*EHOSTUNREACH*|*"network request"*|*"network connectivity"*)
      echo "IdeasWork: 无法下载本地 Runtime Core（${spec}）：当前环境没有网络（沙箱里常见）。" >&2
      echo "  错误码：npm_registry_unreachable" >&2
      echo "  请让用户放开网络权限，或先在有网络的终端运行一次本命令完成安装，然后重试；不要改用其他版本。" >&2 ;;
    *)
      echo "IdeasWork: 本地 Runtime Core（${spec}）安装失败：npm install 未完成。" >&2
      echo "  错误码：npm_install_failed" >&2 ;;
  esac
  printf '%s\n' "$probe" >&2
  exit 1
fi
if [ ! -f "$entry" ]; then
  echo "IdeasWork: 本地 Runtime Core（${spec}）安装后找不到入口（${entry}）。" >&2
  echo "  错误码：launcher_entry_missing" >&2
  exit 1
fi
if ! pinned; then
  echo "IdeasWork: 本地 Runtime Core（${spec}）安装后版本与插件不一致；私有前缀被其他版本占用。" >&2
  echo "  错误码：launcher_version_mismatch" >&2
  exit 1
fi
exec node "$entry" --runtime-only "$@"
